// AIFA persistence map.
//
// Beginner reading guide:
// - Start with Task, AgentEvent, AgentArtifact, HitlDecision, and PendingGate.
// - Task stores one worker run; AgentEvent stores its ordered lifecycle history.
// - Artifact content may live on disk while this database stores its metadata.
// - SQLite is the active local/runtime database; DATABASE_URL isolates dev/tests.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Env-driven so tests/CI/smoke can target an isolated sqlite file and
  // never touch dev.db. Local dev sets DATABASE_URL="file:./dev.db" in .env.
  url      = env("DATABASE_URL")
}

// ============================================
// Core Tables
// ============================================

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  pipelineSessions PipelineSession[]
}

// ============================================
// SDLC Pipeline Tables
// ============================================

// One independent PO->UX->DEV->QA feature-request run against a project's
// uploaded repo. A project can have several of these running concurrently
// (capped by MAX_PARALLEL_WORKFLOWS) — each gets its own working copy under
// workspace/projects/{projectId}/sessions/{id}/repo, so sessions never share
// or overwrite each other's (or the original upload's) files.
model PipelineSession {
  id            String   @id @default(uuid())
  projectId     String
  title         String?
  status        String   @default("running") // running|completed|failed
  repoPath      String?
  workingBranch String?
  baseBranch    String?
  outputDir     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id])
  tasks         Task[]

  @@index([projectId])
}

model Task {
  id                String   @id @default(uuid())
  projectId         String
  sessionId         String?
  type              String   // "extract-flows", "generate-testcases", etc.
  status            String   @default("pending")
  promptProfile     String?
  result            String?  // JSON string
  error             String?
  inputContentHash  String?
  outputContentHash String?
  sourceRunId       String?
  versionStatus     String   @default("committed")
  observability     String?  // JSON string
  // Structured HITL (plan 2.4 / 2.7 / 2.8): a Task is one step's state.
  agentOutput       String?  // JSON string — raw output the agent produced
  approvedOutput    String?  // JSON string — human-approved/edited output (next agent input)
  outputVersion     Int      @default(0) // optimistic lock, bumped on each edit
  retryCount        Int      @default(0)
  lastRetryReason   String?
  gateMode          String?  // strict_manual | confidence_based | auto_approve_safe
  executionStatus   String   @default("queued")
  attempt           Int      @default(0)
  maxAttempts       Int      @default(1)
  lockedBy          String?
  lockedAt          DateTime?
  heartbeatAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project  @relation(fields: [projectId], references: [id])
  session           PipelineSession? @relation(fields: [sessionId], references: [id])
  artifacts         AgentArtifact[]
  events            AgentEvent[]

  @@index([projectId, sessionId])
}

model AgentEvent {
  id         String   @id @default(uuid())
  taskId     String
  projectId  String
  sessionId  String?
  sequence   Int
  type       String
  actor      String
  payload    String?
  envelope   String?  // JSON string — canonical EventEnvelope (preferred over payload for replay)
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Per-session sequence space: every canonical EventEnvelope belongs to a
  // session, and sequence is monotonically allocated by sequenceService.next.
  // The unique constraint enforces the transport invariant at the persistence
  // layer (one per-session sequence space).
  @@unique([sessionId, sequence])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([sessionId, sequence])
}

model AgentArtifact {
  id               String   @id @default(uuid())
  taskId           String
  projectId        String?
  agentType        String?
  artifactType     String
  artifactKey      String?
  title            String?
  // Validation status (T1): VALID | INVALID | PENDING. Default VALID keeps
  // pre-existing rows non-breaking; new rows are set explicitly after the
  // role validator (_validateGateOutput) runs.
  status           String   @default("VALID")
  contentJson      String?  // JSON string
  contentText      String?  // Text
  ordinal          Int      @default(0)
  sourceArtifactId String?
  contentHash      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  task             Task     @relation(fields: [taskId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  fileType  String
  filePath  String
  fileSize  Int
  folderId  String?
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  projectId String
  parentId  String?
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testcase {
  id             String   @id @default(uuid())
  taskId         String
  projectId      String
  featureName    String
  flowName       String
  scenarioData   String?  // JSON string
  automationYaml String?
  yamlFilename   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SessionState {
  id             String   @id @default(uuid())
  page           String
  userId         String
  projectId      String?
  selectedDocIds String?  // JSON string
  taskId         String?
  metadata       String?  // JSON string
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HitlDecision {
  id            String   @id @default(uuid())
  workflowRunId String?
  taskId        String
  projectId     String?
  gate          String?
  decision      String   // "approve", "reject"
  comment       String?
  reviewerId    String?
  // Structured HITL + append-only audit (plan 2.3.3 / 2.8 / 3).
  decisionId        String?  @unique // idempotency key — duplicate is ignored
  action            String?  // approve | reject | edit_approve | escalation_required
  baseOutputVersion Int?     // optimistic lock the decision was made against
  retryReason       String?  // schema_invalid | ac_not_measurable | coverage_gap | build_fail | quality_low | other
  jsonPatch         String?  // JSON string — RFC 6902 operations (for edit_approve)
  payload           String?  // JSON string — extra context (rerun input/output, etc.)
  createdAt     DateTime @default(now())
}

model PendingGate {
  approvalId String   @id
  taskId     String
  projectId  String?
  role       String
  kind       String
  payload    String
  status     String   @default("pending")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resolvedAt DateTime?

  @@index([taskId])
  @@index([projectId])
  @@index([status])
}

model FeatureBacklog {
  id            String   @id @default(uuid())
  projectId     String
  taskId        String?
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

